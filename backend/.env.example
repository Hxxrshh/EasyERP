# ==========================================
# ACCURA Backend - Environment Configuration
# ==========================================

APP_NAME="ACCURA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://billing.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ------------------------------------------
# Database Configuration (MySQL / PostgreSQL for Production)
# ------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lr_billing_prod
DB_USERNAME=lr_billing_user
DB_PASSWORD=YOUR_SECURE_DATABASE_PASSWORD

# ------------------------------------------
# Session & Cache Drivers
# ------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ------------------------------------------
# CORS & Sanctum Security Settings
# ------------------------------------------
CORS_ALLOWED_ORIGINS="https://billing.yourdomain.com,http://localhost:5173"
SANCTUM_STATEFUL_DOMAINS="billing.yourdomain.com,localhost,localhost:5173"

# ------------------------------------------
# Mail Server Configuration
# ------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
